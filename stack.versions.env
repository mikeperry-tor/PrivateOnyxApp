# Private Onyx stack version manifest.
#
# This file is the committed source of truth for wrapper image tags, source
# refs, and build/runtime image defaults. User-specific runtime configuration
# belongs in .env.wrapper; use .env.wrapper only to temporarily override these
# pins while testing an upgrade.

# Onyx application image tags.
ONYX_IMAGE_TAG=v4.8.8
CODE_INTERPRETER_IMAGE_TAG=0.4.9
CODE_INTERPRETER_UPSTREAM_IMAGE=docker.io/onyxdotapp/code-interpreter:0.4.9@sha256:7626d1f139e56d640cd0e333a90f632e26dc986db8641d6dbce45dc494e03580
# Bump when publishing refreshed OS packages, even if upstream pins are unchanged.
OS_SECURITY_UPDATE_REVISION=20261104.1
# The wrapper derives its executor image from the executor release published
# for this API line and a digest of the wrapper Dockerfile plus hashed lock.
PYTHON_EXECUTOR_IMAGE_TAG=0.4.9
PYTHON_EXECUTOR_UPSTREAM_IMAGE=docker.io/onyxdotapp/python-executor-sci:0.4.9@sha256:2c605c21ca26f2e25cd1a6d563ca7a3d6ca061b86dec9db0aa0abfd049b06ce9
PYTHON_EXECUTOR_WRAPPER_IMAGE_REPOSITORY=local/private-onyx-python-executor

# SearXNG rolling-release Docker tag. SearXNG does not publish Git release
# tags; this tag is derived from the upstream commit date and short SHA.
SEARXNG_IMAGE_TAG=2026.7.15-7b2199ecd
# The Makefile derives the final image tag from this repository, the upstream
# tag above, and a digest of every file copied into the derived image.
SEARXNG_WRAPPER_IMAGE_REPOSITORY=local/private-onyx-searxng

# Teep source commit used by `make teep-build`. When TEEP_IMAGE is unset, the
# Makefile derives a local image from this ref, repository, all copied inputs,
# bases and the refresh generation.
TEEP_REF=d9f59d839eb887b50f5afd234e192eac5ec45a2d

# Exact Myst source reviewed for this wrapper from the
# docker_host_fixes_with_logs_v1.38.5 branch.
MYST_NODE_REF=74d144d4261adbb9feb84825946078b8161ebe46

# The wrapper builds the exact digest-verified source revision with the
# no-render stealth feature set and five narrow wrapper patches, then
# copies only the resulting binaries into the digest-pinned upstream runtime.
OBSCURA_RELEASE_VERSION=0.2.5
OBSCURA_UPSTREAM_IMAGE=docker.io/h4ckf0r0day/obscura:0.2.5@sha256:354c3d2a0fa2dd2939debe6903aa26c35d121329245dfa42aa7d1c292a209814
OBSCURA_SOURCE_REF=bd9529418b7fa975b50eabeac415cfaaa865a588
OBSCURA_SOURCE_SHA256=ec5a2862c003f7db16a933447a863047e3b94f7f55804f6c1b8db93fe2cf1995
OBSCURA_BUILDER_IMAGE=docker.io/library/rust:1.94.0-bookworm@sha256:365468470075493dc4583f47387001854321c5a8583ea9604b297e67f01c5a4f
OBSCURA_WRAPPER_IMAGE_REPOSITORY=local/private-onyx-obscura

# Audited multi-architecture Tor base. The wrapper derives its local image tag
# from this immutable reference and tor/Dockerfile.
TOR_BASE_IMAGE=docker.io/dockurr/tor:0.4.9.15@sha256:9dd2ba3f7f945e12da9c1ebe2954196de991cfb097319b94d7b09cb81a6f4bf6
TOR_WRAPPER_IMAGE_REPOSITORY=local/private-onyx-tor

# Support/service images used directly by wrapper compose files.
NGINX_IMAGE=docker.io/library/nginx:1.25.5-alpine@sha256:516475cc129da42866742567714ddc681e5eed7b9ee0b9e9c015e464b4221a00
NETNS_HOLDER_IMAGE=docker.io/library/alpine:3.22@sha256:2e0b81d60597f449baa56dc25d355367869d2dca4cd57e866f1e2b52af3eb55f
PYTHON_SLIM_IMAGE=docker.io/library/python:3.12-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337
PYTHON_ALPINE_IMAGE=docker.io/library/python:3.12-alpine@sha256:e6dae589c1c05976188fd3bd019afd091445fc533ed2ea29001beddc7368a9c8
SOCAT_IMAGE=docker.io/alpine/socat:1.8.0.3@sha256:beb4a68d9e4fe6b0f21ea774a0fde6c31f580dde6368939ed70100c5385b015e
TAILSCALE_UPSTREAM_IMAGE=docker.io/tailscale/tailscale:v1.104.4@sha256:ed6480b33c6eb67c9cbd203ed42b9fb57e361986725b6856def71b7a3d9e276c
MINIO_IMAGE=docker.io/onyxdotapp/minio:RELEASE.2025-07-23T15-54-02Z-cpuv1@sha256:7330be2e7320a7a699b36f72bd06a94d8a21ec9f6f397345d9c38fc6751141f5
# Official upstream release source, matching the selected binary self-report.
# This does not establish the Onyx mirror build provenance.
MINIO_SOURCE_REF=7ced9663e6a791fef9dc6be798ff24cda9c730ac

# Shared, reviewed build stages; passed explicitly to Dockerfiles.
GO_BUILD_IMAGE=docker.io/library/golang:1.26-alpine@sha256:a2012b4a1d1f9f7e9f44e0d39b805a901e856b1dd80b4e6ee4338db547050308
ALPINE_RUNTIME_IMAGE=docker.io/library/alpine:3.22@sha256:2e0b81d60597f449baa56dc25d355367869d2dca4cd57e866f1e2b52af3eb55f
SEARXNG_PYTHON_BUILD_IMAGE=docker.io/library/python:3.14-slim-bookworm@sha256:516b51cb9db2ef061e465c803e50f64361b82cefd91e525b889b967b83e83527
