# Private Onyx stack version manifest.
#
# This file is the committed source of truth for wrapper image tags, source
# refs, and build/runtime image defaults. User-specific runtime configuration
# belongs in .env.wrapper; use .env.wrapper only to temporarily override these
# pins while testing an upgrade.

# Onyx application image tags.
ONYX_IMAGE_TAG=v4.2.5
CODE_INTERPRETER_IMAGE_TAG=0.4.4

# SearXNG rolling-release Docker tag. SearXNG does not publish Git release
# tags; this tag is derived from the upstream commit date and short SHA.
SEARXNG_IMAGE_TAG=2026.6.26-f8ffbf36f

# Teep source commit used by `make teep-build`. When TEEP_IMAGE is unset, the
# Makefile derives 13rac1/teep:${TEEP_REF}, so changing this pin builds and runs
# a distinct image tag.
TEEP_REF=6413fe0547b449e67f7296986fe8b8ffbc9bbcd2

# Locally-built Myst consumer image tag.
MYST_IMAGE=mysteriumnetwork/myst:docker_host_fixes_with_logs

# Companion request-path images.
CRW_IMAGE=ghcr.io/us/crw:0.23.0
OBSCURA_IMAGE=h4ckf0r0day/obscura:0.1.10

# Support/service images used directly by wrapper compose files.
NETNS_HOLDER_IMAGE=alpine:3.20
PYTHON_SLIM_IMAGE=python:3.12-slim-bookworm
PYTHON_ALPINE_IMAGE=python:3.12-alpine
SOCAT_IMAGE=alpine/socat:1.8.0.3
TAILSCALE_IMAGE=tailscale/tailscale:stable
AUTOHEAL_IMAGE=willfarrell/autoheal:latest
MINIO_IMAGE=minio/minio:RELEASE.2025-07-23T15-54-02Z-cpuv1
VALKEY_IMAGE=docker.io/valkey/valkey:9-alpine
