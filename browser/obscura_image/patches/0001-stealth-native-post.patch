+            ("no-referrer-when-downgrade", [Some(full), Some(full), None]),
+            ("same-origin", [Some(full), None, None]),
+            ("origin", [Some(origin), Some(origin), Some(origin)]),
+            ("strict-origin", [Some(origin), Some(origin), None]),
+            ("origin-when-cross-origin", [Some(full), Some(origin), Some(origin)]),
+            ("strict-origin-when-cross-origin", [Some(full), Some(origin), None]),
+            ("unsafe-url", [Some(full), Some(full), Some(full)]),
