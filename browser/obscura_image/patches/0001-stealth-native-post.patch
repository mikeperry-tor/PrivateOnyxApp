+/// Navigation referrer policies are separate from the cookie initiator:
+/// suppressing a referrer must never turn a cross-site POST into same-site.
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
+pub enum ReferrerPolicy {
+    NoReferrer,
+    NoReferrerWhenDowngrade,
+    SameOrigin,
+    Origin,
+    StrictOrigin,
+    OriginWhenCrossOrigin,
+    #[default]
+    StrictOriginWhenCrossOrigin,
+    UnsafeUrl,
+}
+
+impl ReferrerPolicy {
+    pub fn parse_token(value: &str) -> Option<Self> {
+        match value.trim().to_ascii_lowercase().as_str() {
+            "no-referrer" => Some(Self::NoReferrer),
+            "no-referrer-when-downgrade" => Some(Self::NoReferrerWhenDowngrade),
+            "same-origin" => Some(Self::SameOrigin),
+            "origin" => Some(Self::Origin),
+            "strict-origin" => Some(Self::StrictOrigin),
+            "origin-when-cross-origin" => Some(Self::OriginWhenCrossOrigin),
+            "strict-origin-when-cross-origin" => Some(Self::StrictOriginWhenCrossOrigin),
+            "unsafe-url" => Some(Self::UnsafeUrl),
+            _ => None,
+        }
+    }
+
+    pub fn from_header(value: &str) -> Option<Self> {
+        // Repeated HTTP fields are comma-folded by merge_response_header.
+        value.split(',').filter_map(Self::parse_token).last()
+    }
+
+    fn referrer(self, source: &Url, target: &Url) -> Option<Url> {
+        if !matches!(source.scheme(), "http" | "https")
+            || !matches!(target.scheme(), "http" | "https") {
+            return None;
+        }
+        let same_origin = source.origin() == target.origin();
+        let downgrade = source.scheme() == "https" && target.scheme() == "http";
+        if self == Self::NoReferrer
+            || (self == Self::SameOrigin && !same_origin)
+            || (downgrade && matches!(self, Self::NoReferrerWhenDowngrade
+                | Self::StrictOrigin | Self::StrictOriginWhenCrossOrigin)) {
+            return None;
+        }
+        let mut value = source.clone();
+        let _ = value.set_username("");
+        let _ = value.set_password(None);
+        value.set_fragment(None);
+        let origin_only = matches!(self, Self::Origin | Self::StrictOrigin)
+            || (!same_origin && matches!(self, Self::OriginWhenCrossOrigin
+                | Self::StrictOriginWhenCrossOrigin))
+            || value.as_str().len() > 4096;
+        if origin_only {
+            value.set_path("/");
+            value.set_query(None);
+        }
+        Some(value)
+    }
+}
+
+pub(crate) struct NavigationReferrer {
+    source: Option<Url>,
+    policy: ReferrerPolicy,
+}
+
+impl NavigationReferrer {
+    pub(crate) fn new(request: &ResourceRequest) -> Self {
+        Self {
+            source: request.referrer.clone().or_else(|| request.initiator.clone()),
+            policy: request.navigation_referrer_policy,
+        }
+    }
+
+    pub(crate) fn header(&mut self, request: &ResourceRequest, target: &Url) -> Option<String> {
+        if request.mode != RequestMode::Navigate {
+            return request_referrer(request, target);
+        }
+        // Fetch reduces the referrer at each hop. A later redirect cannot
+        // recover a stripped path/query or resurrect an omitted referrer.
+        self.source = self.source.as_ref().and_then(|source| self.policy.referrer(source, target));
+        self.source.as_ref().map(ToString::to_string)
+    }
+
+    pub(crate) fn redirect(&mut self, headers: &HashMap<String, String>) {
+        if let Some(policy) = headers.get("referrer-policy").and_then(|v| ReferrerPolicy::from_header(v)) {
+            self.policy = policy;
+        }
     }
 }

