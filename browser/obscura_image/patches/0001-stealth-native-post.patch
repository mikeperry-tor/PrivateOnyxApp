+#[cfg(all(test, feature = "stealth"))]
+mod private_onyx_patch_tests {
+    use super::{redirected_navigation_method, StealthHttpClient};
+    use crate::cookies::CookieJar;
+    use std::sync::Arc;
+
+    #[test]
+    fn private_onyx_stealth_form_redirect_semantics() {
+        for status in [301, 302, 303] {
+            assert_eq!(
+                redirected_navigation_method(status, "POST", "q=private"),
+                ("GET".to_string(), String::new())
+            );
+        }
+        for status in [307, 308] {
+            assert_eq!(
+                redirected_navigation_method(status, "POST", "q=private"),
+                ("POST".to_string(), "q=private".to_string())
+            );
+        }
+    }
+
+    #[test]
+    fn private_onyx_stealth_get_and_post_share_client_and_cookie_jar() {
+        let jar = Arc::new(CookieJar::new());
+        let client = StealthHttpClient::new(jar.clone());
+        assert!(Arc::ptr_eq(&client.cookie_jar, &jar));
+        assert_eq!(client.active_requests(), 0);
+    }
+}
