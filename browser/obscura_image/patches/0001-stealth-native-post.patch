+    *crossed_site |= !same_site(source, target);
+    if !*crossed_site {
+        SameSiteContext::SameSite
+    } else if method_is_safe {
+        SameSiteContext::CrossSiteTopLevelSafe
+    } else {
+        SameSiteContext::CrossSite
+    }
