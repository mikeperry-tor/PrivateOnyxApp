+fn redirected_navigation_method(
+    status: u16,
+    method: &str,
+    body: &str,
+) -> (String, String) {
+    if matches!(status, 301 | 302 | 303) {
+        ("GET".to_string(), String::new())
+    } else {
+        (method.to_string(), body.to_string())
+    }
+}
