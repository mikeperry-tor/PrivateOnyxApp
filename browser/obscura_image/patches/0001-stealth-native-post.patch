+    #[test]
+    fn private_onyx_stealth_form_redirect_semantics() {
+        for status in [301, 302, 303] {
+            let (method, body) = redirected_navigation_method(
+                status,
+                wreq::Method::POST,
+                Some(b"q=private".to_vec()),
+            );
+            assert_eq!(method, wreq::Method::GET);
+            assert_eq!(body, None);
+        }
+        for status in [307, 308] {
+            let expected = b"q=private".to_vec();
+            let (method, body) = redirected_navigation_method(
+                status,
+                wreq::Method::POST,
+                Some(expected.clone()),
+            );
+            assert_eq!(method, wreq::Method::POST);
+            assert_eq!(body, Some(expected));
+        }
+    }
+
+    #[tokio::test]
+    async fn private_onyx_stealth_get_and_post_share_client_and_cookie_jar() {
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let url = Url::parse(&format!("http://{}/", listener.local_addr().unwrap())).unwrap();
+        let server = tokio::spawn(async move {
+            let mut observed = Vec::new();
+            for cookie in ["sid=first; Path=/", "sid=second; Path=/", "sid=; Max-Age=0; Path=/"] {
+                let (mut stream, _) = tokio::time::timeout(Duration::from_secs(5), listener.accept())
+                    .await.unwrap().unwrap();
+                let mut bytes = Vec::new();
+                loop {
+                    let mut buf = [0; 1024];
+                    let count = tokio::time::timeout(Duration::from_secs(5), stream.read(&mut buf))
+                        .await.unwrap().unwrap();
+                    assert_ne!(count, 0);
+                    bytes.extend_from_slice(&buf[..count]);
+                    if let Some(end) = bytes.windows(4).position(|w| w == b"\r\n\r\n") {
+                        let head = String::from_utf8_lossy(&bytes[..end]).to_ascii_lowercase();
+                        let length = head.lines().find_map(|line| line.strip_prefix("content-length:"))
+                            .map(|value| value.trim().parse::<usize>().unwrap()).unwrap_or(0);
+                        if bytes.len() >= end + 4 + length { break; }
+                    }
+                }
+                observed.push(String::from_utf8(bytes).unwrap());
+                stream.write_all(format!("HTTP/1.1 200 OK\r\nContent-Length: 2\r\nSet-Cookie: {cookie}\r\nConnection: close\r\n\r\nok").as_bytes())
+                    .await.unwrap();
+            }
+            observed
+        });
+        let jar = Arc::new(CookieJar::new());
+        let client = StealthHttpClient {
+            client: wreq::Client::builder().no_proxy().build().unwrap(),
+            allow_private_network: true,
+            block_trackers: false,
+            cookie_jar: jar.clone(),
+            extra_headers: tokio::sync::RwLock::new(std::collections::HashMap::new()),
+            in_flight: Arc::new(std::sync::atomic::AtomicU32::new(0)),
+        };
+        client.fetch_with_callbacks(&url, None).await.unwrap();
+        let (_, method) = client.post_form_with_callbacks(
+            &url, "q=fixture", crate::ResourceRequest::navigation(), None,
+        ).await.unwrap();
+        assert_eq!(method, "POST");
+        client.fetch_with_callbacks(&url, None).await.unwrap();
+        let observed = server.await.unwrap();
+        assert!(observed[0].starts_with("GET / HTTP/1.1\r\n"));
+        assert!(!observed[0].to_ascii_lowercase().contains("\r\ncookie:"));
+        assert!(observed[1].starts_with("POST / HTTP/1.1\r\n"));
+        assert!(observed[1].ends_with("\r\n\r\nq=fixture"));
+        assert!(observed[1].to_ascii_lowercase().contains("\r\ncookie: sid=first\r\n"));
+        assert!(observed[2].starts_with("GET / HTTP/1.1\r\n"));
+        assert!(observed[2].to_ascii_lowercase().contains("\r\ncookie: sid=second\r\n"));
+        assert!(jar.get_all_cookies().is_empty());
+        assert_eq!(client.active_requests(), 0);
+    }
