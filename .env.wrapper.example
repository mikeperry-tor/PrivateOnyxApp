# Wrapper environment variables
#
# Use this as the starting point for your local .env.wrapper:
#   make up-lite
#   make up-full
#
# Image tags and source refs live in stack.versions.env. Put overrides here
# only when testing a local upgrade or alternate image.

# =============================================================================
# 1. Wrapper Runtime
# =============================================================================
#
# Local container engine used by the Makefile and wrapper installer shim.
# Use Docker 25.0+/Compose 2.20.2+, or a running rootless Podman 5.8.1+
# machine with a Compose provider 2.20.2+. The verified macOS guest baseline is
# the official 5.8.1 machine-os image.
CONTAINER_BIN=docker

# =============================================================================
# 2. Host Endpoints
# =============================================================================
#
# Ports exposed on the host for browser access or local tooling.
HOST_PORT_ONYX_WEBUI=3000
HOST_PORT_SEARXNG=8080
HOST_PORT_TEEP=8337
# Full-mode/RAG-only local document browser port.
HOST_PORT_ONYX_RAG_DOC_WEB=8091

# This sets one absolute WebUI origin URL for the Onyx WebUI. Keep the localhost
# default unless another hostname should be used for user invitation and
# password-reset links, generated absolute links, MCP OAuth callbacks, and
# origin-checked WebSockets (for voice support).
#
# Choosing the HTTPS Tailscale Funnel URL is convenient for public invitation,
# verification, and password-reset links. The https scheme will also cause
# cookies to be marked https-only, preventing browsers from sending those
# cookies over downgraded HTTP connections. However, login through the HTTP
# onion URL or http://localhost:3000 will then break.
WEBUI_CANONICAL_ORIGIN="http://localhost:3000"

# =============================================================================
# 3. Teep Private Inference
# =============================================================================
#
# Teep is the local private inference proxy. It does not use
# EGRESS_UPSTREAM_PROXY_URL; use TEEP_ROUTE_THROUGH_MYST_VPN if you want
# provider traffic to leave through the Mysterium namespace.

# Extra args passed to `teep serve`. Offline mode avoids external transparency
# log/service calls that can rate-limit teep's current request pattern.
TEEP_SERVE_ARGS="--offline"

# When false, Teep runs on the normal compose network and publishes
# HOST_PORT_TEEP directly. When true, trusted Teep joins the Mysterium namespace,
# including its loopback, interfaces, routes, and policy listeners, and host
# access is provided by a small proxy bridge.
TEEP_ROUTE_THROUGH_MYST_VPN=false

# Provider API keys. Set at least one key for a provider you plan to use.
#TEEP_TINFOIL_API_KEY="sk-rp-..."
#TEEP_NEARAI_API_KEY="API_KEY_HERE"
#TEEP_VENICE_API_KEY="VENICE_INFERENCE_KEY_..."
#TEEP_CHUTES_API_KEY="cpk_..."
#TEEP_PHALA_API_KEY="sk-rp-..."

# =============================================================================
# 4. Optional Mysterium VPN
# =============================================================================
#
# Shared VPN substrate for browser/search/RAG traffic and any component that is
# explicitly placed into the Mysterium namespace. Teep and Tailscale have their
# own placement switches in their sections.

# Master VPN switch. When false, the topology and namespace-readiness sentinel
# stay intact, but no Myst daemon, VPN connection, kill-switch, wallet,
# registration, or funding flow is started.
MYST_VPN_ENABLED=false

# Mysterium WireGuard MTU. This defaults to the minimum value to prevent VPN
# requests from hanging when the upstream network drops oversized packets.
MYST_VPN_WIREGUARD_MTU=1280

# Optional comma-separated provider identities to try before normal
# autoselection. Useful after you find a reliable Mysterium provider or
# set of providers. `docker exec myst-client-vpn myst connection info`
# will tell you your current provider.
#MYST_VPN_PREFERRED_PROVIDER_IDS=""

# Optional order defaults used by make vpn-signup-orderform.
MYST_VPN_ORDER_AMOUNT="100"
MYST_VPN_ORDER_CURRENCY="MYST"
MYST_VPN_ORDER_GATEWAY="coingate"
MYST_VPN_ORDER_COUNTRY="US"
# Gateway-specific metadata, for example a CoinGate custom_id.
MYST_VPN_ORDER_GATEWAY_DATA="custom_id=mysterium-onyx"
# Required only when more than one identity exists in docker-data/myst-data.
#MYST_VPN_IDENTITY="0x0000000000000000000000000000000000000000"

# =============================================================================
# 5. Agent Web, Browser, Chat Bots, Code Egress, And Security
# =============================================================================
#
# Controls for Onyx web access, browser automation, open_url limits, and the
# default SSRF posture.

# Block cleartext http:// internet targets. Explicitly allowed local MCP, Web
# Connector, inference, and embedding endpoints may still use HTTP. Enabling
# public HTTP does not grant additional host or private-network access.
EGRESS_ALLOW_HTTP_URLS=false

# Optional upstream proxy for agent internet activity and configured
# MCP/Web/inference/embedding clients. Network-enabled generated code also uses
# it. This changes the route, not destination permissions: agent browsing and
# generated code still cannot target host, LAN, metadata, or stack-managed
# service addresses.
#
# Supported schemes are http://, https://, socks5://, and socks5h://. Invalid
# URLs fail policy-proxy startup. Proxy credentials are not printed in logs.
# Leave empty for direct/VPN egress. When empty, the stack then obtains target
# addresses from the VPN provider's DNS in VPN mode, or from system DNS in
# no-VPN mode, validates the complete answer set, and connects only to 
# approved addresses.
#
# Examples:
#   EGRESS_UPSTREAM_PROXY_URL="http://user:pass@proxy.example.com:8080"
#   EGRESS_UPSTREAM_PROXY_URL="https://user:pass@proxy.example.com:8443"
#   EGRESS_UPSTREAM_PROXY_URL="socks5://proxy.example.com:1080"
#   EGRESS_UPSTREAM_PROXY_URL="socks5h://host.docker.internal:9150"
#
# A proxy at host.docker.internal, or at an RFC1918 IP literal, is usable as
# routing infrastructure without granting general host/LAN target access.
# Operator-local proxy names ending in .local, .internal, or .home.arpa require
# ONYX_INTEGRATIONS_ALLOW_LAN_ENDPOINTS=true. Target names are sent to this
# proxy in name-based connection requests; the stack resolves and classifies
# the configured proxy endpoint, but never receives or directly connects to the
# target name's resolved address. A target name resolving to a private IP is
# therefore reached from this upstream proxy's egress network, unless that
# upstream proxy also rejects it.
EGRESS_UPSTREAM_PROXY_URL=""

# =============================================================================
# 5a. Optional Native Tor
# =============================================================================
#
# Route supported agent Internet activity and configured external integrations
# through Tor. This changes outbound traffic only: it does not route Teep
# provider or Tailscale traffic over Tor, or enable browsing to .onion
# destinations. If Tor is unavailable, affected requests fail instead of
# silently using a direct connection.
TOR_EGRESS_ENABLED=false

# Publish the WebUI at a persistent public v3 onion address for access with Tor
# Browser. After startup, run `make tor-onion-address` to display the address.
TOR_ONION_SERVICE_ENABLED=false

# Optional strict clearnet exit selection. Country accepts one two-letter code.
# Fingerprints accepts at most 16 comma-separated 40-hex relay identities, with
# an optional leading $. These options cannot both be set together.
# Fixed exits reduce availability and may reduce anonymity-set diversity.
TOR_EXIT_COUNTRY=""
TOR_EXIT_NODE_FINGERPRINTS=""

# Let explicitly configured MCP servers, Web Connectors, embedding servers, and
# inference providers reach RFC1918 LAN destinations. MCP and Web Connector
# access also depends on Admin -> Security Hardening. This never gives web
# search, open_url(), browser activity, or generated code access to the host,
# LAN, metadata endpoints, or stack-managed services.
#
# host.docker.internal is already allowed for those configured integrations and
# model endpoints and does not require this option. host.docker.internal is
# never available to the Agent via its tools, even with this pref set to true.
#
# NOTE: When this pref is true, we still prevent Agent-selected tools
# and code from accessing LAN endpoints, but a compromised Onyx server will
# become able to access your LAN devices. Leaving this false prevents Onyx
# code from accessing your LAN, even if compromised (up to docker breakout).
ONYX_INTEGRATIONS_ALLOW_LAN_ENDPOINTS=false

# Optional global context-window override for chat LLMs. Leave empty to use
# Onyx's saved/provider-detected model limits. Set this when a provider
# advertises no limit, advertises a value that is too low, or advertises a
# larger window than you actually want Onyx to use. For example, use 500000 for
# a model that advertises 1M tokens but behaves better below 500k. When set,
# this wins over both Onyx's saved model setting and the provider-advertised
# limit, so updating it only requires restarting the stack, not removing the
# model.
ONYX_AGENT_LLM_MAX_TOKENS=900000

# Preserve previous-turn tool outputs in future LLM context. Upstream Onyx
# normally replaces prior tool responses with a short placeholder when later
# turns are built. This wrapper defaults to true so follow-up turns can inspect
# saved tool responses for custom/MCP tools, search, open_url,
# code-interpreter, and code-agent. Set false to restore upstream behavior.
ONYX_AGENT_PRESERVE_TOOL_RESULTS=true

# Force Onyx's reasoning-model detection to treat the configured chat model as
# natively reasoning-capable. This avoids synthetic think_tool prompting in the
# code agent, deep research, and nested research agent when OpenAI-compatible
# providers such as teep/Tinfoil/GLM stream proper reasoning_content fields but
# LiteLLM does not recognize the provider/model pair. Set false to restore
# upstream/LiteLLM model detection.
ONYX_AGENT_USE_NATIVE_REASONING=true

# Preserve assistant reasoning within the active user turn. This keeps the
# current turn's reasoning across tool calls after the most recent user
# message, which is essential for optimal behavior from GLM-5.2 and Kimi-K2.6.
# Set false to restore upstream Onyx behavior for current-turn reasoning.
ONYX_AGENT_PRESERVE_TURN_REASONING=true

# Preserve assistant reasoning from all previous turns as well. This can
# improve long multi-turn continuity for reasoning models, but it spends more
# context on prior hidden reasoning. The default keeps only active-turn
# reasoning.
ONYX_AGENT_PRESERVE_ALL_REASONING=false

# Provide nested Deep Research agents with the tools enabled for the selected
# chat Agent, after the per-chat tool dropdown has been applied. The wrapper
# executes accepted calls with the fixed limits in docker-compose.yaml and does
# not silently discard additional tool names from the same model response.
ONYX_DEEP_RESEARCH_PROVIDE_CHAT_AGENT_TOOLS=true

# Full-mode-only Slack and Discord chat agents run persistent background
# processes. They are absent by default; opt in explicitly to use the
# credentials and configuration saved in Onyx. These settings have no effect
# in lite mode because lite mode has no background supervisor.
ONYX_AGENT_SLACK_BOT=false
ONYX_AGENT_DISCORD_BOT=false

# open_url content budgets. Set a positive integer to cap returned characters,
# or 0 for an effectively unlimited wrapper cap. If only the per-URL cap is set,
# the total budget defaults to 10x that value.
ONYX_OPEN_URL_MAX_CHARS_PER_URL=0
ONYX_OPEN_URL_MAX_TOTAL_CHARS=0

# Browser implementation for the built-in Onyx Web Crawler. The default false
# uses Onyx's stock requests fetch with its local Playwright Chromium fallback.
# Set true to use the wrapper's single-navigation Obscura path. Both stock
# stages remain public-only, use the fixed public final-hop proxy, and delegate
# target DNS/address enforcement to that final hop. This does not change
# SearXNG: the wrapper's search engines always use Obscura. In current parallel
# testing, the stock crawler is blocked less often than Obscura 0.1.10; revisit
# this default as newer Obscura releases improve.
ONYX_AGENT_USE_OBSCURA_BROWSER=false

# SearXNG search-provider scheduling. When true, each SearXNG web query uses
# one browser-backed provider at a time instead of fanning out to every provider.
# Normal providers are rotated first; providers marked last_resort in
# SearXNG settings, currently bing2, are used only when all normal providers
# are already suspended or unavailable.
SEARXNG_ROUND_ROBIN=true

# Maximum document size accepted by the open_url() tool's crawler, in MiB.
#
# It does not affect external web-content providers, document ingestion/indexing
# for RAG, or retrieval of a document already indexed for RAG. SearXNG search
# keeps its own fixed 20 MiB rendered-DOM limit for search result parsing.
#
# Both stock and Obscura perform a complete response before the wrapper rejects
# an oversized result, so this is not a peak-memory or download bound.
ONYX_OPEN_URL_MAX_DOCUMENT_SIZE_MB=20

# Advanced browser navigation waits. The stack uses Obscura's event-driven
# waitUntil mechanism instead of fixed sleeps. The four values below are the
# only accepted values; any other value fails at startup. They fire in order, so
# selecting a later event waits for all earlier events first:
#   1. domcontentloaded - DOM parsed and scripts executed
#   2. load             - subresources finished and onload fired
#   3. networkidle2     - <=2 active network requests for 500ms
#   4. networkidle0     - 0 active network requests for 500ms
#
# Obscura enforces a finite navigation deadline, so a page that never reaches
# the chosen event still returns instead of hanging. Search pages default to
# load because many SERPs hydrate results via JavaScript. Normal open_url pages
# default to domcontentloaded because many sites keep background connections
# open and would otherwise wait until the deadline.
OBSCURA_BROWSER_WAIT_UNTIL_SEARCH=load
OBSCURA_BROWSER_WAIT_UNTIL_WEB=domcontentloaded

# New installations seed Onyx Admin -> Security Hardening to "Allow Private
# Network" for configured MCP servers and Web Connectors. This permits
# host.docker.internal; RFC1918 LAN targets additionally require
# ONYX_INTEGRATIONS_ALLOW_LAN_ENDPOINTS=true. It does not grant private access
# to web search, open_url(), browser activity, or generated code. Loopback,
# link-local, and metadata targets remain unavailable.

# =============================================================================
# 6. Onyx Code Interpreter
# =============================================================================
#
# Executor capability and resource limits for Python tool and code-agent
# sessions.

# When false, generated code has no network access. When true, it can make
# public HTTP/HTTPS requests through the selected VPN/upstream-proxy/no-VPN
# route, including requests to public search engines. It still cannot use
# direct internet sockets or reach the host, LAN/private targets, metadata
# addresses, or stack-managed services, regardless of LAN settings.
ONYX_CODE_INTERPRETER_ENABLE_NETWORK=false

# Resource limits. The file-size limit is one MiB-valued ceiling for both
# code-interpreter uploads and coding-agent GitHub repository tarball downloads;
# it is unrelated to the open_url character budgets above. Raise the remaining
# values if data analysis or plotting workloads hit memory, CPU-time, timeout,
# or output truncation errors.
ONYX_CODE_INTERPRETER_MAX_FILE_SIZE_MB="1000"
ONYX_CODE_INTERPRETER_MAX_OUTPUT_BYTES="20000000"
ONYX_CODE_INTERPRETER_MEMORY_LIMIT_MB="512"
ONYX_CODE_INTERPRETER_CPU_TIME_LIMIT_SEC="60"
ONYX_CODE_INTERPRETER_MAX_EXEC_TIMEOUT_MS="120000"

# =============================================================================
# 7. Tailscale Funnel
# =============================================================================
#
# Optional public HTTPS exposure of the Onyx WebUI through Tailscale Funnel.
# Tailscale does not use EGRESS_UPSTREAM_PROXY_URL.

TAILSCALE_FUNNEL_ENABLED=false

# Route trusted Tailscale through the Mysterium namespace. This also grants the
# process access to that namespace's loopback, interfaces, routes, and policy
# listeners. Leaving this false avoids that broader trust and avoids linking
# your Tailscale identity to the VPN exit IP.
TAILSCALE_FUNNEL_ROUTE_THROUGH_MYST_VPN=false

# Set an auth key from Tailscale admin settings when Funnel is enabled.
TAILSCALE_FUNNEL_AUTHKEY=""
TAILSCALE_FUNNEL_HOSTNAME="onyx"
# Optional extra args passed to `tailscale up`, such as ACL tags.
TAILSCALE_FUNNEL_UP_ARGS=""

# =============================================================================
# 8. Full Mode RAG
# =============================================================================
#
# Local document RAG, local embedding shim, and internal_search context budgets.
# These settings are used by make up-full.

# Local document directory served read-only to Onyx's Web connector.
# The default is the wrapper's `doc-drop` directory, but this may point to another
# local or externally mounted directory. Docker bind-mounts it read-only.
# Podman serves it through a managed host process without copying it into the VM.
ONYX_RAG_DOC_SOURCE_DIR=./doc-drop

# Prefixes applied by the local embedding shim for asymmetric retrieval models.
# These are crucial for modern SOTA embedding models. Customizing the query for
# your specific query pattern and document types will improve results.
# The quoted \n becomes an actual newline inside the container.
ONYX_RAG_EMBEDDING_QUERY_PREFIX="Instruct: Given a document query, retrieve the most relevant chunk.\nQuery: "
ONYX_RAG_EMBEDDING_PASSAGE_PREFIX=""

# OpenAI-compatible /v1/embeddings endpoint used by the local embedding shim.
# The default also enables automatic startup of an installed bundled MLX server
# during `make up-full`. Its model unloads after 10 idle minutes; a later request
# includes cold load, then has a 5-minute blocked-operation bound. For Teep, use
# http://host.docker.internal:8337/v1/embeddings and set
# ONYX_RAG_EMBEDDING_SHIM_UPSTREAM_MODEL below.
ONYX_RAG_EMBEDDING_SHIM_UPSTREAM_URL="http://host.docker.internal:3210/v1/embeddings"

# MLX model installed by `make embedserv-install` and used by the server.
ONYX_RAG_EMBEDDING_MLX_SERVE_MODEL="majentik/harrier-oss-v1-0.6b-MLX-8bit"

# Batch this many chunks into a single embedding API request
ONYX_RAG_EMBEDDING_BATCH_SIZE="32"

# Optional upstream auth and model alias. Leave the model unset when using the
# bundled MLX embedding server; it defaults to ONYX_RAG_EMBEDDING_MLX_SERVE_MODEL.
# For Teep, use neardirect:Qwen/Qwen3-Embedding-0.6B. Do not change the MLX
# model setting above when selecting a Teep model.
#ONYX_RAG_EMBEDDING_SHIM_UPSTREAM_API_KEY=""
#ONYX_RAG_EMBEDDING_SHIM_UPSTREAM_MODEL=""

# Optional internal_search() character caps for model-facing local RAG context.
# Onyx's own retrieval/selection section counts are left unchanged. After Onyx
# has grouped chunks, asked the chat LLM to select/expand sections, merged
# overlaps, and serialized the result JSON, these optional caps trim the
# returned content by characters per result and across all results. Leave empty
# or set 0 for no wrapper cap.
ONYX_RAG_INTERNAL_SEARCH_MAX_CONTENT_CHARS_PER_RESULT=0
ONYX_RAG_INTERNAL_SEARCH_MAX_TOTAL_CONTENT_CHARS=0
