# Wrapper environment variables
#
# Use with:
#   make up-lite
# or
#   make up-full
# or
#   docker compose --env-file .env.wrapper up -d

# Host port mappings
HOST_PORT=3000
SEARXNG_PORT=8080
SEARXNG_CONTAINER_PORT=8888
TEEP_PORT=8337
TEEP_CONTAINER_PORT=8337

# Onyx image tags used by wrapper-routed services
ONYX_IMAGE_TAG=v3.2.12

# Keep code-interpreter on latest unless you have a known compatible pinned tag.
CODE_INTERPRETER_IMAGE_TAG=latest

# teep provider API keys (set at least one).
#NEARAI_API_KEY="API_KEY_HERE"
#VENICE_API_KEY="VENICE_INFERENCE_KEY_..."
#CHUTES_API_KEY="cpk_..."
#PHALA_API_KEY="sk-rp-..."

# Comma separated list of myst provider ids that are reliable (otherwise will
# autoconnect, which may take a while/fail to find a live one)
#MYST_PROVIDER_IDS=""

# Myst order auto-creation (optional): set all four values to auto-create
# funding orders when registration remains unregistered/inprogress.
#MYST_ORDER_AMOUNT="100"
#MYST_ORDER_CURRENCY="MYST"
#MYST_ORDER_GATEWAY="coingate"
#MYST_ORDER_COUNTRY="US"
# Gateway-specific metadata (e.g. custom_id for coingate, lightning_network=true)
#MYST_ORDER_GATEWAY_DATA="custom_id=mysterium-onyx"
# Set true to pause connection attempts until balance is funded.
#MYST_WAIT_FOR_FUNDS="true"
